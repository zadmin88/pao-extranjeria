---
import { SITE, SERVICES, servicePath } from "@/config";
import WhatsAppButton from "@/components/WhatsAppButton.astro";

const desktopLinks = [
  { href: "/", label: "Inicio" },
  { href: "/#servicios", label: "Trámites" },
  { href: "/#como-trabajamos", label: "Cómo trabajamos" },
  { href: "/#preguntas", label: "Dudas frecuentes" },
];

const mobileLinks = [
  { href: "/", label: "Inicio" },
  ...SERVICES.map((s) => ({ href: servicePath(s.slug), label: s.menuLabel })),
  { href: "/#preguntas", label: "Dudas frecuentes" },
];
---

<header
  class="sticky top-0 z-30 border-b border-border/70 bg-background/85 backdrop-blur supports-backdrop-filter:bg-background/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.brand} — inicio`}>
      <span
        aria-hidden="true"
        class="flex size-9 -rotate-3 items-center justify-center rounded-md border-2 border-primary font-heading text-sm font-bold text-primary"
      >
        {SITE.name.charAt(0)}
      </span>
      <span class="font-heading text-lg font-semibold tracking-tight text-primary">
        {SITE.brand}
      </span>
    </a>

    <nav aria-label="Menú principal" class="hidden items-center gap-1 md:flex">
      {
        desktopLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
      <WhatsAppButton label="WhatsApp" class="ml-2" />
    </nav>

    <!-- Menú móvil sin JavaScript: <details> + CSS -->
    <div class="flex items-center gap-1 md:hidden">
      <WhatsAppButton label="WhatsApp" />
      <details class="group relative">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-lg text-foreground hover:bg-muted [&::-webkit-details-marker]:hidden"
          aria-label="Menú"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="size-5 group-open:hidden"
          >
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            class="hidden size-5 group-open:block"
          >
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <nav
          aria-label="Menú móvil"
          class="absolute top-full right-0 z-40 mt-2 flex w-64 flex-col gap-1 rounded-xl border border-border bg-popover p-2 shadow-lg"
        >
          {
            mobileLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-lg px-3 py-2.5 font-medium text-foreground hover:bg-muted"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Cierra el menú móvil al tocar fuera o al elegir un enlace de ancla.
  const menu = document.querySelector<HTMLDetailsElement>("header details");
  if (menu) {
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => (menu.open = false))
    );
  }
</script>
