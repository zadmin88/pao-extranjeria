---
import type { Service } from "@/config";
import { servicePath } from "@/config";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={servicePath(service.slug)}
  class="group relative mt-3 block rounded-xl rounded-tl-none border border-border bg-card p-6 transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
>
  <span
    aria-hidden="true"
    class="absolute -top-3 left-0 h-3 w-20 rounded-t-md border border-b-0 border-border bg-card transition-colors group-hover:border-primary/40"
  ></span>
  <h3 class="font-heading text-xl font-semibold text-primary">{service.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{service.short}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-saffron-deep">
    Ver requisitos
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4 transition-transform group-hover:translate-x-0.5"
    >
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>
  </span>
</a>
