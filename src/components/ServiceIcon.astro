---
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className } = Astro.props;

const icons: Record<string, string> = {
  arraigo: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8.5 12l2.5 2.5L16 9"/>',
  renovaciones:
    '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>',
  "residencia-inicial": '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="12" r="2"/><path d="M14 10h4M14 14h4"/>',
  "reagrupacion-familiar":
    '<circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3 2.5-5 5-5s5 2 5 5"/><path d="M14 20c0-2.2 1.5-4 3.5-4s3.5 1.8 3.5 4"/>',
  modificaciones: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
};
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["shrink-0", className]}
  set:html={icons[slug] ?? ""}
/>
