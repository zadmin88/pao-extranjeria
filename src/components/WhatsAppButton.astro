---
import { waLink } from "@/config";
import { cn } from "@/lib/utils";

interface Props {
  message?: string;
  label?: string;
  size?: "lg" | "md";
  variant?: "pill" | "minimal";
  /** "wa": píldora verde de WhatsApp (acción principal, uso por defecto).
   * "primary": píldora en el eggplant de marca, sin ícono de WhatsApp —
   * para el botón "Contacto" de la barra, que es navegación, no la CTA
   * principal. "lavender": píldora en el morado claro de marca — para el
   * botón "Contacto" del menú móvil, a pedido del cliente. */
  tone?: "wa" | "primary" | "lavender";
  /** Oculta el ícono de WhatsApp (solo aplica al variant "pill"). */
  icon?: boolean;
  class?: string;
}

const {
  message,
  label = "Escríbeme por WhatsApp",
  size = "md",
  variant = "pill",
  tone = "wa",
  icon = true,
  class: className,
} = Astro.props;
---

{
  variant === "minimal" ? (
    <a
      href={waLink(message)}
      target="_blank"
      rel="noopener"
      class={cn(
        "group inline-flex items-center gap-2.5 font-heading font-medium text-wa-deep transition-colors hover:text-wa",
        size === "lg" ? "text-lg" : "text-sm",
        className
      )}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class={size === "lg" ? "size-5" : "size-4"}>
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413" />
      </svg>
      <span class="underline decoration-1 underline-offset-4 opacity-90 group-hover:opacity-100">{label}</span>
    </a>
  ) : (
    <a
      href={waLink(message)}
      target="_blank"
      rel="noopener"
      class={cn(
        "inline-flex items-center justify-center gap-2 rounded-full font-heading font-semibold transition-colors active:translate-y-px",
        tone === "primary" &&
          "bg-primary text-primary-foreground hover:bg-primary/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
        tone === "lavender" &&
          "bg-lavender text-primary hover:bg-lavender/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
        tone === "wa" &&
          "bg-wa text-white hover:bg-wa-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wa-deep",
        size === "lg" ? "h-13 px-7 text-base" : "h-10 px-5 text-sm",
        className
      )}
    >
      {icon && (
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class={size === "lg" ? "size-5.5" : "size-4.5"}>
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413" />
        </svg>
      )}
      {label}
    </a>
  )
}
