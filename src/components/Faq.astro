---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<!-- first:pt-0: sin esto, el título de la sección que precede a este
     acordeón (con su propio mt-5 sm:mt-7 estándar) sumaba ese margen AL
     py-6 del primer <details>, quedando con más aire título→contenido que
     cualquier otro título→párrafo/cards del sitio. Quitando el padding
     superior solo al primer item, el margen del contenedor exterior pasa
     a ser la única fuente de espacio y el ritmo queda igual en toda la
     página. -->
<div class="divide-y divide-border/60">
  {
    items.map((item, index) => (
      <details class="reveal group py-6 first:pt-0" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-medium text-primary sm:text-xl [&::-webkit-details-marker]:hidden">
          {item.q}
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5 shrink-0 text-lavender-deep transition-transform group-open:rotate-45"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground" set:html={item.a} />
      </details>
    ))
  }
</div>
