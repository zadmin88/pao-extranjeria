---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import CtaSection from "@/components/CtaSection.astro";
import Faq from "@/components/Faq.astro";
import { SITE, SERVICES, TESTIMONIALS, servicePath } from "@/config";
import arraigoImg from "@/assets/servicios/arraigo.jpg";
import renovacionesImg from "@/assets/servicios/renovaciones.jpg";
import residenciaInicialImg from "@/assets/servicios/residencia-inicial.jpg";
import reagrupacionFamiliarImg from "@/assets/servicios/reagrupacion-familiar.jpg";
import modificacionesImg from "@/assets/servicios/modificaciones.jpg";

// Mismas fotos (banco de imágenes libres, Unsplash) que ya usa el hero de
// cada página de trámite — a pedido del cliente, las cards de "Trámites"
// pasaron de un ícono de línea sobre bg-lavender/70 a una foto real por
// trámite, reutilizando exactamente las mismas imágenes en vez de buscar
// unas nuevas, para que la card de acá y el hero de la página de destino
// muestren la misma foto (consistencia al hacer clic en "Ver más").
const cardImages: Record<string, ImageMetadata> = {
  arraigo: arraigoImg,
  renovaciones: renovacionesImg,
  "residencia-inicial": residenciaInicialImg,
  "reagrupacion-familiar": reagrupacionFamiliarImg,
  modificaciones: modificacionesImg,
};

const cardStyle = {
  bg: "bg-lavender/15",
  fg: "text-primary",
  muted: "text-muted-foreground",
  accent: "text-lavender-deep",
};

const seoTitle = `Asesoría de Extranjería Online para Latinos en España | ${SITE.brand}`;
const seoDescription =
  "Asesoría de extranjería online en toda España: arraigo social y sociolaboral, renovaciones, residencia inicial, reagrupación familiar y modificaciones. Escríbeme por WhatsApp y te digo qué necesitas.";

const faqs = [
  {
    q: "¿Atiendes online?",
    a: "Sí, 100% online con personas en toda España. Los trámites de extranjería se presentan de forma telemática, así que da igual si estás en Madrid, Barcelona, Valencia o un pueblo pequeño.",
  },
  {
    q: "¿Cuánto cuesta?",
    a: "La primera consulta por WhatsApp es para entender tu caso y decirte qué necesitas. Antes de empezar cualquier trámite te doy el precio cerrado, sin sorpresas.",
  },
  {
    q: "¿Qué trámite necesito?",
    a: "Con tres datos ya puedo orientarte: cuánto tiempo llevas en España (y cómo puedes demostrarlo), si tienes pasaporte vigente y si tienes oferta de trabajo o ingresos. Escríbeme y lo vemos en unos minutos.",
  },
  {
    q: "¿Cuánto tarda?",
    a: "Depende del trámite y de la oficina de extranjería de tu provincia. Como referencia, la administración tiene hasta 3 meses para resolver la mayoría de solicitudes. Te voy informando del estado en todo momento.",
  },
  {
    q: "¿Qué documentación necesito?",
    a: "Cambia según el trámite. En cuanto me cuentas tu caso te doy la lista exacta de documentos, con formato, apostillas y traducciones incluidas si hacen falta.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: SITE.brand,
    description: SITE.tagline,
    url: SITE.url,
    telephone: SITE.phoneDisplay,
    email: SITE.email,
    areaServed: { "@type": "Country", name: "España" },
    knowsLanguage: "es",
    founder: { "@type": "Person", name: SITE.name },
    makesOffer: SERVICES.map((s) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: s.title,
        url: new URL(servicePath(s.slug), SITE.url).href,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription} jsonLd={jsonLd} transparentHeader>
  <!-- Apertura: hero con foto a pantalla completa, nav integrada -->
  <section id="hero" class="relative h-[72svh] min-h-[560px] overflow-hidden rounded-b-[2.5rem] sm:h-[85svh] sm:min-h-[640px] sm:rounded-b-[3rem]">
    <picture>
      <source media="(min-width: 640px)" srcset="/foto_paola_completa_desk.png" />
      <img
        src="/foto_paola_completa_mob.png"
        alt="Paola Ocampo, asesora de extranjería"
        width="752"
        height="1344"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full origin-bottom scale-125 object-cover object-[50%_0%] sm:origin-center sm:scale-100 sm:object-[64%_10%]"
      />
    </picture>
    <div class="reveal absolute inset-x-6 inset-y-0 z-10 flex max-w-[19rem] flex-col justify-start pt-28 sm:inset-x-10 sm:max-w-lg sm:justify-center sm:pt-0 lg:inset-x-16">
      <h1
        class="font-heading leading-[1.05] font-medium text-primary [text-shadow:0_2px_24px_rgba(255,255,255,0.7)]"
        style="font-size: clamp(1.75rem, 6vw, 3.75rem);"
      >
        Soy <span class="text-lavender-deep">Paola Ocampo</span>, te ayudo con tus trámites de extranjería en España.
      </h1>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <WhatsAppButton size="lg" label="Escríbeme por WhatsApp" />
      </div>
    </div>
  </section>

  <!-- Trámites: carrusel horizontal de tarjetas -->
  <!-- El ancla de scroll (id + scroll-mt) vive en el div interior, no en
       la <section>: si estuviera en la section, el salto por nav
       aterrizaba antes de su padding-top (py-24/py-32 = hasta 128px), y
       encima el clearance del header (72px), dejando el título "muy
       abajo" con un hueco enorme arriba — el cliente lo notó al clickear
       "Trámites" en desktop. Poniendo el ancla después del padding, el
       salto cae justo donde empieza el contenido real. -->
  <section aria-labelledby="tramites-titulo" class="py-24 sm:py-32">
    <div id="tramites" class="scroll-mt-32 mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
      <div class="reveal mb-5 sm:mb-7">
        <h2
          id="tramites-titulo"
          class="font-heading leading-[1.05] font-medium text-primary"
          style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
        >
          Trámites
        </h2>
      </div>

      <div
        data-carousel="tramites"
        class="reveal -ml-6 -mr-6 flex snap-x snap-mandatory gap-8 overflow-x-auto pt-2 pr-[7.5vw] pb-4 pl-[7.5vw] sm:-ml-10 sm:-mr-10 sm:gap-10 sm:scroll-pl-10 sm:pt-3 sm:pr-10 sm:pl-10 lg:-ml-16 lg:-mr-16 lg:scroll-pl-16 lg:pr-16 lg:pl-16 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          SERVICES.map((s) => {
            const style = cardStyle;
            return (
              <a
                href={servicePath(s.slug)}
                class:list={[
                  "carousel-card group flex w-[85vw] shrink-0 snap-center sm:snap-start flex-col rounded-[2rem] p-3 sm:w-[23rem] sm:p-4",
                  style.bg,
                ]}
              >
                <Image
                  src={cardImages[s.slug]}
                  alt=""
                  width={460}
                  height={288}
                  class="aspect-[16/10] w-full rounded-[1.5rem] object-cover"
                />
                <div class="flex flex-1 flex-col px-2 pt-5 pb-2 sm:px-3 sm:pt-6">
                  <h3
                    class:list={[
                      "font-heading text-2xl leading-[1.05] font-medium sm:text-[1.75rem]",
                      style.fg,
                    ]}
                  >
                    {s.title}
                  </h3>
                  <p class:list={["mt-0.5 flex-1 leading-relaxed", style.muted]}>{s.short}</p>
                  <span
                    class:list={[
                      "mt-8 inline-flex items-center gap-2 font-heading text-base font-semibold transition-colors group-hover:text-primary",
                      style.accent,
                    ]}
                  >
                    Ver más
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-4 transition-transform group-hover:translate-x-1"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>

      <!-- justify-start, no justify-end: en la esquina inferior derecha
           vive el botón flotante fijo de WhatsApp (WhatsAppFloat.astro) —
           con las flechas ahí mismo, la flecha "siguiente" quedaba tapada
           por el botón y parecía que nunca se desactivaba al llegar al
           final. -->
      <div class="mt-6 flex justify-start gap-3">
        <button
          type="button"
          data-carousel-prev="tramites"
          aria-label="Trámite anterior"
          class="flex size-11 items-center justify-center rounded-full bg-lavender/25 text-primary transition-colors hover:bg-lavender/40 disabled:pointer-events-none disabled:opacity-30"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <button
          type="button"
          data-carousel-next="tramites"
          aria-label="Siguiente trámite"
          class="flex size-11 items-center justify-center rounded-full bg-lavender/25 text-primary transition-colors hover:bg-lavender/40 disabled:pointer-events-none disabled:opacity-30"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Sobre Paola -->
  <section
    id="paola"
    aria-labelledby="paola-titulo"
    class="scroll-mt-16 flex min-h-[90svh] items-center bg-primary py-24 sm:py-32"
  >
    <div class="mx-auto max-w-3xl px-6 text-center sm:px-10 lg:px-16">
      <h2
        id="paola-titulo"
        class="reveal font-heading leading-[1.08] font-medium text-primary-foreground"
        style="font-size: clamp(2.25rem, 6vw, 4.5rem);"
      >
        Soy <span class="text-lavender">Paola</span>.
      </h2>
      <p class="reveal mx-auto mt-5 max-w-xl text-base leading-relaxed text-paper/85 sm:mt-7 sm:text-lg">
        Llevo 7 años ayudando a personas migrantes latinoamericanas a
        entender y resolver su situación migratoria en España. Sé lo que es
        enfrentarse a trámites sin saber por dónde empezar.
      </p>
      <p class="reveal mx-auto mt-4 max-w-xl leading-relaxed text-paper/60">
        Por eso trabajo de la forma más cercana posible: por WhatsApp,
        acompañándote en cada paso. Reviso personalmente cada caso,
        documento a documento, antes de presentarlo.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section aria-labelledby="preguntas-titulo" class="bg-lavender/15 py-24 sm:py-32">
    <div id="preguntas" class="scroll-mt-32 mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
      <div class="reveal lg:grid lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2
            id="preguntas-titulo"
            class="font-heading leading-[1.05] font-medium text-primary"
            style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
          >
            Preguntas frecuentes
          </h2>
        </div>
        <div class="mt-5 sm:mt-7 lg:col-span-7 lg:col-start-6 lg:mt-0">
          <Faq items={faqs} />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonios: carrusel horizontal, mismo patrón que "Trámites"
       (mismo script de flechas, generalizado por [data-carousel]). Va
       después de "Preguntas frecuentes" y antes del CTA final — a pedido
       del cliente, no justo después de "Trámites" como al principio.
       Layout calcado de la sección "Doctor testimonials" de
       orthofx.com/products/fxclear (varias tarjetas visibles + una
       asomando en el borde, sangrado a la derecha, flechas circulares
       abajo) pero sin foto — solo cita + nombre, a pedido del cliente.
       Contenido de TESTIMONIALS (config.ts) es placeholder marcado
       [PENDIENTE]: hay que reemplazarlo por testimonios reales antes de
       publicar, nunca dejarlo así en producción. Fondo blanco (sin tinte
       lavanda): a pedido del cliente, "Trámites" y "Testimonios" quedan
       en blanco para que se note el contraste con las secciones que sí
       llevan fondo (Preguntas, CTA final) — si esta sección alguna vez
       lleva tinte, revisar que siga sin quedar pegada visualmente a
       "Preguntas frecuentes" (arriba) ni al CTA final (abajo), que sí lo
       llevan. -->
  <section aria-labelledby="testimonios-titulo" class="py-24 sm:py-32">
    <div class="mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
      <div class="reveal mb-5 sm:mb-7">
        <h2
          id="testimonios-titulo"
          class="font-heading leading-[1.05] font-medium text-primary"
          style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
        >
          Lo que dicen mis clientes
        </h2>
      </div>

      <div
        data-carousel="testimonios"
        class="reveal -ml-6 -mr-6 flex snap-x snap-mandatory gap-8 overflow-x-auto pt-2 pr-[11vw] pb-4 pl-[11vw] sm:-ml-10 sm:-mr-10 sm:gap-10 sm:scroll-pl-10 sm:pt-3 sm:pr-10 sm:pl-10 lg:-ml-16 lg:-mr-16 lg:scroll-pl-16 lg:pr-16 lg:pl-16 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          TESTIMONIALS.map((t) => (
            <figure class="carousel-card flex w-[78vw] shrink-0 snap-center sm:snap-start flex-col justify-between rounded-[2rem] bg-lavender/15 p-7 sm:w-[21rem] sm:p-8">
              <svg
                aria-hidden="true"
                viewBox="0 0 32 24"
                fill="currentColor"
                class="size-6 text-lavender-deep/70"
              >
                <path d="M9.352 4C4.456 7.456 1 12.928 1 19.36c0 5.088 3.088 8.64 7.472 8.64 4.16 0 7.008-3.264 7.008-7.104 0-3.84-2.688-6.624-6.176-6.624-.688 0-1.408.096-1.6.192.576-3.264 3.872-7.104 7.2-9.024L9.352 4zm18.24 0c-4.896 3.456-8.352 8.928-8.352 15.36 0 5.088 3.088 8.64 7.472 8.64 4.16 0 7.008-3.264 7.008-7.104 0-3.84-2.688-6.624-6.176-6.624-.688 0-1.408.096-1.6.192.576-3.264 3.872-7.104 7.2-9.024L27.592 4z" />
              </svg>
              <blockquote class="mt-5 flex-1 font-heading text-base leading-relaxed text-primary sm:text-lg">
                {t.quote}
              </blockquote>
              <figcaption class="mt-6 font-heading text-sm font-semibold text-lavender-deep">
                {t.name}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="mt-6 flex justify-start gap-3">
        <button
          type="button"
          data-carousel-prev="testimonios"
          aria-label="Testimonio anterior"
          class="flex size-11 items-center justify-center rounded-full bg-lavender/25 text-primary transition-colors hover:bg-lavender/40 disabled:pointer-events-none disabled:opacity-30"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <button
          type="button"
          data-carousel-next="testimonios"
          aria-label="Siguiente testimonio"
          class="flex size-11 items-center justify-center rounded-full bg-lavender/25 text-primary transition-colors hover:bg-lavender/40 disabled:pointer-events-none disabled:opacity-30"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
