---
import ServiceLayout from "@/layouts/ServiceLayout.astro";
import { SERVICES } from "@/config";
import heroImage from "@/assets/servicios/reagrupacion-familiar.jpg";

const service = SERVICES.find((s) => s.slug === "reagrupacion-familiar")!;

const faqs = [
  {
    q: "¿Cuánto tiempo debo llevar en España para reagrupar a mi familia?",
    a: "Como regla general, necesitas haber residido legalmente al menos un año y tener autorización para residir al menos otro año más. Para reagrupar a ascendientes (padres o suegros) se exige residencia de larga duración.",
  },
  {
    q: "¿Cuántos ingresos necesito para reagrupar?",
    a: "Se calculan en función del IPREM según cuántas personas formen tu unidad familiar tras la reagrupación. Los importes se actualizan cada año; escríbeme y te calculo la cifra exacta que te pedirán con tu composición familiar.",
  },
  {
    q: "¿Puedo reagrupar a mi pareja si no estamos casados?",
    a: "Sí: la relación de pareja no registrada también da derecho a reagrupar si puedes acreditar una relación estable análoga a la conyugal. El nuevo reglamento facilita la prueba de estas relaciones.",
  },
  {
    q: "¿Mis hijos reagrupados podrán trabajar en España?",
    a: "Los familiares reagrupados en edad laboral quedan habilitados para trabajar sin trámites adicionales desde la concesión de su autorización. Es una de las mejoras del reglamento vigente.",
  },
];

const steps = [
  {
    title: "Cálculo de ingresos",
    text: "Calculo contigo los ingresos exigidos para tu composición familiar exacta.",
  },
  {
    title: "Calendario",
    text: "Gestiono el calendario completo: informe de vivienda, solicitud, visado y TIE.",
  },
  {
    title: "Documentación",
    text: "Preparo la documentación de España y la de tu país (actas, apostillas, traducciones).",
  },
  {
    title: "Seguimiento",
    text: "Sigo el expediente y respondo requerimientos hasta que tu familia está aquí.",
  },
];

const options = [
  {
    q: "Cónyuge o pareja",
    a: "Registrada o no registrada, con relación estable acreditada.",
  },
  {
    q: "Hijos menores de edad",
    a: "Tuyos o de tu pareja, incluidos los adoptados.",
  },
  {
    q: "Hijos mayores con discapacidad",
    a: "Que dependan económicamente de ti.",
  },
  {
    q: "Ascendientes",
    a: "Padres o suegros a cargo, cuando tienes residencia de larga duración y existen razones que justifiquen su venida.",
  },
];

const requisitos = [
  {
    title: "Un año de residencia",
    text: "Haber residido legalmente en España al menos 1 año y tener autorización para al menos otro año más.",
  },
  {
    title: "Ingresos suficientes",
    text: "Según el IPREM, en función del tamaño de la familia resultante.",
  },
  {
    title: "Vivienda adecuada",
    text: "Informe emitido por tu comunidad autónoma o ayuntamiento.",
  },
  {
    title: "Asistencia sanitaria",
    text: "Cubierta por la seguridad social o un seguro privado.",
  },
];
---

<ServiceLayout
  service={service}
  seoTitle="Reagrupación familiar en España: requisitos e ingresos 2026"
  seoDescription="Trae legalmente a tu cónyuge, hijos o padres a España: requisitos de tiempo de residencia, ingresos (IPREM), informe de vivienda y todo el expediente de reagrupación familiar. Asesoría online por WhatsApp."
  heroIntro="Vivir con tu familia no debería ser un laberinto. La reagrupación familiar tiene requisitos claros — tiempo de residencia, ingresos y vivienda — y cuando el expediente va bien armado, funciona. Te ayudo a conseguirlo."
  heroImage={heroImage}
  heroImageAlt="Padre e hija esperando la llegada de un familiar en el aeropuerto"
  introTitle="Qué es la reagrupación familiar"
  introText="Es la autorización que permite a un residente legal en España traer a sus familiares directos para vivir juntos. La tramitas tú como reagrupante desde España y, una vez aprobada, tu familiar solicita su visado en el consulado y viaja con su residencia aprobada."
  faqs={faqs}
  steps={steps}
  options={options}
  optionsTitle="A quién puedes reagrupar"
  requisitos={requisitos}
  avisoText="El informe de vivienda y el cálculo de ingresos son los dos puntos donde más expedientes se caen. Antes de pedir cita para nada, escríbeme: revisamos si tus números y tu vivienda cumplen, y si no, cómo llegar a cumplirlos."
>
  <Fragment slot="h1">Reagrupación familiar: <span class="text-lavender-deep">trae a los tuyos</span> a España</Fragment>
</ServiceLayout>
