---
import ServiceLayout from "@/layouts/ServiceLayout.astro";
import { SERVICES } from "@/config";
import heroImage from "@/assets/servicios/renovaciones.jpg";

const service = SERVICES.find((s) => s.slug === "renovaciones")!;

const faqs = [
  {
    q: "¿Qué plazos no puedo dejar pasar en la renovación?",
    a: "Desde 60 días naturales antes de que caduque tu tarjeta ya puedes presentar la renovación. Hasta 90 días naturales después de la caducidad todavía se admite, aunque puede acarrear sanción. Mientras se resuelve, tu autorización queda prorrogada automáticamente si presentaste en plazo.",
  },
  {
    q: "¿Cuándo tengo que renovar mi residencia?",
    a: "Puedes presentar la renovación durante los 60 días naturales anteriores a la caducidad de tu tarjeta. Si se te pasa la fecha, todavía tienes 90 días naturales después de la caducidad, aunque puede conllevar sanción. Lo ideal es no apurar.",
  },
  {
    q: "¿Puedo seguir trabajando mientras se resuelve la renovación?",
    a: "Sí. Presentada la solicitud en plazo, tu autorización se entiende prorrogada hasta que haya resolución. Guarda el justificante de presentación: es tu prueba de que estás en trámite.",
  },
  {
    q: "¿Por cuánto tiempo se renueva la residencia?",
    a: "Con el nuevo reglamento, la mayoría de renovaciones se conceden por 4 años, y en varios supuestos ya no se distingue entre segunda renovación y larga duración como antes. Al renovar revisamos también si ya puedes pedir la residencia de larga duración.",
  },
  {
    q: "¿Qué pasa si estuve un tiempo sin trabajar?",
    a: "No siempre es un problema: se valoran las cotizaciones acumuladas, prestaciones recibidas, informes sociales y otras circunstancias. Hay más flexibilidad de la que la gente cree, pero hay que argumentarlo bien en el expediente.",
  },
];

const steps = [
  {
    title: "Calendario",
    text: "Te aviso con antelación de cada fecha límite.",
  },
  {
    title: "Revisión",
    text: "Reviso tu vida laboral y tus documentos para detectar problemas antes que extranjería.",
  },
  {
    title: "Presentación",
    text: "Presento la solicitud telemáticamente y sigo el expediente hasta la resolución.",
  },
  {
    title: "Respuesta",
    text: "Si hay requerimiento o denegación, preparo la respuesta o el recurso.",
  },
];

const options = [
  {
    q: "Cuenta ajena y cuenta propia",
    a: "Residencia y trabajo por cuenta ajena y por cuenta propia.",
  },
  {
    q: "Arraigo",
    a: "Residencia obtenida por arraigo, el paso siguiente tras tu primera tarjeta.",
  },
  {
    q: "Reagrupación familiar",
    a: "Residencia por reagrupación familiar, la tuya o la de tus familiares.",
  },
  {
    q: "No lucrativa y estudiantes",
    a: "Residencia no lucrativa y de estudiantes (prórrogas de estancia).",
  },
  {
    q: "Larga duración",
    a: "Paso a residencia de larga duración cuando cumples 5 años legales.",
  },
];

const requisitos = [
  {
    title: "Solicitud y tasas",
    text: "Solicitud en modelo oficial y tasas pagadas.",
  },
  {
    title: "Pasaporte y tarjeta",
    text: "Pasaporte completo vigente y la tarjeta que estás renovando.",
  },
  {
    title: "Historial laboral",
    text: "Vida laboral, contrato o nóminas, en autorizaciones de trabajo.",
  },
  {
    title: "Empadronamiento",
    text: "Actualizado y, según el caso, escolarización de los hijos menores.",
  },
];
---

<ServiceLayout
  service={service}
  seoTitle="Renovación de residencia y trabajo en España: plazos y requisitos"
  seoDescription="Renueva tu autorización de residencia y trabajo sin poner en riesgo tus papeles: plazos (60 días antes, 90 después), documentación y renovaciones de 4 años con el nuevo reglamento. Te acompaño por WhatsApp."
  heroIntro="Una renovación presentada tarde o con documentos mal preparados puede costarte la residencia que tanto te costó conseguir. Yo me encargo de que llegue a tiempo, completa y bien argumentada."
  heroImage={heroImage}
  heroImageAlt="Agenda abierta sobre un escritorio con fechas marcadas"
  introTitle="Por qué la renovación importa tanto"
  introText="Conseguir la primera tarjeta es solo el principio: mantenerla depende de renovar en plazo y de demostrar que sigues cumpliendo los requisitos. La buena noticia es que el nuevo Reglamento de Extranjería (Real Decreto 1155/2024) ha simplificado las renovaciones y ha ampliado su duración: la mayoría se conceden ahora por 4 años."
  faqs={faqs}
  steps={steps}
  options={options}
  optionsTitle="Renovaciones con las que te ayudo"
  requisitos={requisitos}
  avisoText="Cada renovación tiene matices según tu tipo de autorización y tu situación laboral. Escríbeme con la fecha de caducidad de tu tarjeta y te digo hoy mismo qué necesitas y cuándo conviene presentar."
>
  <Fragment slot="h1">Renovación de residencia y trabajo, <span class="text-lavender-deep">a tiempo y sin sustos</span></Fragment>
</ServiceLayout>
