---
import ServiceLayout from "@/layouts/ServiceLayout.astro";
import { SERVICES } from "@/config";
import heroImage from "@/assets/servicios/residencia-inicial.jpg";

const service = SERVICES.find((s) => s.slug === "residencia-inicial")!;

const faqs = [
  {
    q: "¿Puedo pedir la residencia inicial estando ya en España?",
    a: "Depende de la vía. Los arraigos y algunas autorizaciones excepcionales se piden desde España; la residencia por cuenta ajena ordinaria o la no lucrativa se solicitan normalmente desde tu país a través del consulado. Lo primero es identificar qué vía encaja contigo.",
  },
  {
    q: "¿Qué es el NIE y en qué se diferencia de la TIE?",
    a: "El NIE es tu número de identidad de extranjero: un número que te acompaña siempre. La TIE es la tarjeta física que acredita tu autorización de residencia. Primero se concede la autorización y después se solicita la TIE con huellas.",
  },
  {
    q: "¿Cuánto dinero tengo que demostrar para una residencia no lucrativa?",
    a: "Se exige un porcentaje del IPREM anual para el titular y un extra por cada familiar. La cifra exacta se actualiza cada año, así que conviene calcularla con los valores vigentes en el momento de tu solicitud. Te la calculo para tu caso concreto.",
  },
  {
    q: "¿Qué hago primero si acabo de llegar a España?",
    a: "Empadrónate cuanto antes en tu domicilio: el padrón es la prueba principal de tu permanencia y te abre la puerta a la sanidad y a futuros trámites como el arraigo. Después, guarda todo documento con fecha a tu nombre.",
  },
];

const steps = [
  {
    title: "Diagnóstico",
    text: "Estudio tu caso y te propongo la vía con más probabilidades de éxito.",
  },
  {
    title: "Documentación",
    text: "Lista de documentos personalizada, con formato, apostillas y traducciones incluidas.",
  },
  {
    title: "Presentación",
    text: "Preparación y presentación del expediente completo.",
  },
  {
    title: "TIE",
    text: "Acompañamiento hasta la TIE: citas, huellas y recogida de la tarjeta.",
  },
];

const options = [
  {
    q: "Residencia y trabajo por cuenta ajena",
    a: "Con una oferta de empleo, tramitada desde tu país vía consulado.",
  },
  {
    q: "Arraigo",
    a: "Si ya llevas 2 o 3 años viviendo en España — es la vía más común para regularizarse desde dentro.",
  },
  {
    q: "Familiar de ciudadano de la UE o español",
    a: "Si tu cónyuge, pareja registrada o familiar directo es español o comunitario.",
  },
  {
    q: "Residencia no lucrativa",
    a: "Si tienes ingresos o ahorros suficientes para vivir sin trabajar en España.",
  },
  {
    q: "Estudios",
    a: "Estancia por estudios que después puede convertirse en residencia y trabajo.",
  },
];
---

<ServiceLayout
  service={service}
  seoTitle="Residencia inicial en España: tu primera autorización paso a paso"
  seoDescription="Tu primera autorización de residencia en España: por trabajo, arraigo, familiar o no lucrativa. Te explico qué vía te corresponde, los requisitos y te acompaño en todo el proceso, incluida la TIE."
  heroIntro="Conseguir tu primera residencia en España no es un solo trámite: es elegir bien la vía, reunir los documentos correctos y presentarlos donde toca. Te guío desde el primer papel hasta que tienes tu tarjeta en la mano."
  heroImage={heroImage}
  heroImageAlt="Viajeros con maletas caminando por una terminal de aeropuerto"
  introTitle="No hay una sola puerta de entrada"
  introText='"Residencia inicial" es la primera autorización que te permite vivir (y normalmente trabajar) legalmente en España. Existen varias vías, y elegir la equivocada significa perder meses y dinero.'
  faqs={faqs}
  steps={steps}
  options={options}
  optionsTitle="Las vías más habituales entre latinos"
>
  <Fragment slot="h1">Tu primera residencia en España, <span class="text-lavender-deep">paso a paso</span></Fragment>
</ServiceLayout>
