---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { SITE } from "@/config";
---

<BaseLayout
  title={`Página no encontrada | ${SITE.brand}`}
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <div class="mx-auto flex max-w-3xl flex-col items-start gap-5 px-4 py-24 sm:px-6">
    <span class="stamp text-xl font-medium">Expediente no encontrado</span>
    <h1 class="font-heading text-4xl font-medium text-primary">
      Esta página no existe
    </h1>
    <p class="max-w-xl text-lg text-muted-foreground">
      Puede que el enlace haya cambiado. Vuelve al inicio para ver todos los
      trámites, o escríbeme directamente y te oriento.
    </p>
    <div class="flex flex-wrap gap-4">
      <a
        href="/"
        class="inline-flex h-11 items-center rounded-full bg-primary px-6 font-heading font-semibold text-primary-foreground transition-colors hover:bg-primary/85"
      >
        Volver al inicio
      </a>
      <WhatsAppButton />
    </div>
  </div>
</BaseLayout>
