---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import Faq from "@/components/Faq.astro";
import type { FaqItem } from "@/components/Faq.astro";
import { SITE, SERVICES, servicePath } from "@/config";
import type { Service } from "@/config";

interface Step {
  title: string;
  text: string;
}

interface Requisito {
  title: string;
  text: string;
}

interface Props {
  service: Service;
  seoTitle: string;
  seoDescription: string;
  heroIntro: string;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  introTitle: string;
  introText: string;
  faqs: FaqItem[];
  steps: Step[];
  options: FaqItem[];
  optionsTitle: string;
  ctaLabel?: string;
  requisitos?: Requisito[];
  avisoText?: string;
}

const {
  service,
  seoTitle,
  seoDescription,
  heroIntro,
  heroImage,
  heroImageAlt,
  introTitle,
  introText,
  faqs,
  steps,
  options,
  optionsTitle,
  ctaLabel = "Consulta tu caso por WhatsApp",
  requisitos,
  avisoText,
} = Astro.props;

const pageUrl = new URL(servicePath(service.slug), SITE.url).href;
const related = SERVICES.filter((s) => s.slug !== service.slug);

const stripHtml = (html: string) => html.replace(/<[^>]+>/g, "");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: service.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.title,
    description: service.short,
    url: pageUrl,
    serviceType: service.title,
    areaServed: { "@type": "Country", name: "España" },
    availableChannel: {
      "@type": "ServiceChannel",
      name: "WhatsApp",
      servicePhone: { "@type": "ContactPoint", telephone: SITE.phoneDisplay },
    },
    provider: {
      "@type": "ProfessionalService",
      name: SITE.brand,
      url: SITE.url,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: stripHtml(f.a) },
    })),
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <article>
    <!-- Cabecera en dos columnas (texto + foto), fondo blanco — se probó
         eggplant sólido (mismo tratamiento que "Sobre Paola" en la home) y
         el cliente lo revirtió a blanco. H1 en eggplant (text-primary) con
         la frase intermedia en lavanda-deep (el tono pensado para leerse
         sobre blanco), párrafo en muted-foreground, chips en pastilla
         lavanda clara — misma paleta que el resto de la página, ya no la
         paleta clara/invertida del intento en eggplant. El CTA usa
         tone="primary" (eggplant), la excepción puntual a la regla de "CTA
         siempre en verde de WhatsApp" que sí pidió el cliente, sin el
         ícono de WhatsApp. Sin eyebrow arriba del H1 ni tarjeta superpuesta
         sobre la foto. En mobile la foto pasa debajo del texto. Misma
         diagramación en las 5 páginas de trámite. -->
    <header class="pt-20 pb-14 sm:pt-24 sm:pb-16">
      <div class="mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
        <div class="lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-10 xl:gap-x-16">
          <div class="lg:col-span-6">
            <h1
              class="reveal max-w-xl font-heading leading-[1.05] font-medium text-primary"
              style="font-size: clamp(1.85rem, 4.2vw, 3.5rem);"
            >
              <slot name="h1" />
            </h1>
            <p class="reveal mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground sm:mt-7">
              {heroIntro}
            </p>
            <!-- Excepción puntual a la regla de "CTA principal siempre en
                 verde de WhatsApp": a pedido del cliente, el botón del
                 hero en las 5 páginas de trámite va en el eggplant de
                 marca (tone="primary"), no en el verde de WhatsApp que sí
                 se mantiene en el resto de botones del sitio (CtaSection,
                 WhatsAppFloat, etc.). Sin el ícono de WhatsApp (icon=false):
                 el logo de WhatsApp en un botón morado ya no comunica lo
                 mismo que en uno verde, así que se saca en vez de dejarlo
                 como decoración fuera de contexto. -->
            <div class="reveal mt-8">
              <WhatsAppButton size="lg" tone="primary" icon={false} message={service.whatsAppMessage} label={ctaLabel} />
            </div>
          </div>
          <div class="reveal mt-12 lg:col-span-6 lg:mt-0">
            <Image
              src={heroImage}
              alt={heroImageAlt}
              width={900}
              height={1080}
              class="aspect-[3/2] w-full rounded-[2.5rem] object-cover"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- Introducción + tipos/opciones: dos columnas lado a lado (no
         apiladas) — a pedido del cliente, calcada de un ejemplo de
         referencia. Fondo lavanda claro compartido por las dos columnas
         (se probó una tarjeta redondeada solo para "Qué es X", dejando
         "Tipos de X" sin fondo, y el cliente pidió volver al fondo único
         cubriendo ambas). La intro ("Qué es X") es un H2 + párrafo
         estático — nada de acordeón acá, el "+"/"×" es solo para "Tipos de
         X" a la derecha, que sí tiene varias opciones para
         plegar/desplegar. -->
    <section class="bg-lavender/15 py-24 sm:py-32">
      <div class="mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
        <div class="lg:grid lg:grid-cols-12 lg:gap-x-12">
          <div class="reveal lg:col-span-5">
            <h2
              class="font-heading leading-[1.05] font-medium text-primary"
              style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
            >
              {introTitle}
            </h2>
            <p class="mt-5 max-w-lg leading-relaxed text-muted-foreground sm:mt-7">
              {introText}
            </p>
          </div>
          <div class="reveal mt-10 lg:col-span-6 lg:col-start-7 lg:mt-0">
            <h2
              id="opciones-titulo"
              class="font-heading leading-[1.05] font-medium text-primary"
              style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
            >
              {optionsTitle}
            </h2>
            <div class="mt-5 sm:mt-7">
              <Faq items={options} />
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Requisitos: tarjetas en grid (2 columnas desde sm+), cada una con
         título corto en negrita + descripción debajo (antes era una sola
         línea de texto por tarjeta) — mismo patrón título+texto que ya
         usan las cards de "Cómo te ayudo", calcado de un ejemplo de
         referencia del cliente. Fondo blanco de sección — a pedido del
         cliente, que organizó el color de las secciones de la página como
         blanco/lavanda-clara/blanco/eggplant/lavanda-clara (hero,
         intro+tipos, requisitos, cómo te ayudo, preguntas). Las tarjetas
         van en bg-lavender/15 — el mismo tono de lavanda claro que usan
         las secciones con fondo ("Qué es X"/"Tipos de X", "Preguntas
         frecuentes"): el cliente pidió que el morado claro fuera un único
         tono en todo el sitio, se use como fondo de sección o como fondo
         de card, en vez de dos valores distintos (/15 y /25) que se leían
         como colores diferentes. El aviso "Importante" va como texto
         plano, sin caja ni
         fondo (a pedido del cliente, que la vio muy pesada visualmente
         junto a las tarjetas de arriba) — solo la etiqueta "Importante:"
         en negrita distingue el párrafo del resto del contenido. Sección
         opcional: solo se renderiza
         si la página pasa `requisitos` (residencia-inicial no tiene una
         lista de requisitos separada del resto de su prosa, así que no la
         usa). -->
    {
      requisitos && requisitos.length > 0 && (
        <section aria-labelledby="requisitos-titulo" class="py-24 sm:py-32">
          <div class="mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
            <h2
              id="requisitos-titulo"
              class="reveal font-heading leading-[1.05] font-medium text-primary"
              style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
            >
              Requisitos
            </h2>
            <ul class="mt-5 grid gap-4 sm:mt-7 sm:grid-cols-2">
              {requisitos.map((req) => (
                <li class="reveal rounded-[2rem] bg-lavender/15 p-6 sm:p-7">
                  <h3 class="font-heading text-lg font-medium text-primary">{req.title}</h3>
                  <p class="mt-0.5 leading-relaxed text-muted-foreground">{req.text}</p>
                </li>
              ))}
            </ul>
            {avisoText && (
              <p class="reveal mt-6 max-w-3xl leading-relaxed text-muted-foreground">
                <strong class="font-semibold text-primary">Importante: </strong>
                {avisoText}
              </p>
            )}
          </div>
        </section>
      )
    }


    <!-- Cómo te ayudo: tarjetas, no una lista numerada (a pedido del
         cliente, sin números junto a los títulos). Fondo eggplant sólido
         — a pedido del cliente, que organizó el color de las secciones de
         la página como blanco/lavanda-clara/blanco/eggplant/lavanda-clara
         (hero, intro+tipos, requisitos, cómo te ayudo, preguntas). Con el
         fondo oscuro, título en text-primary-foreground y tarjetas en
         lavanda sólida (bg-lavender, no bg-lavender/15) con texto oscuro:
         un tinte semitransparente sobre un fondo oscuro se mezcla con
         él y queda casi tan oscuro como el fondo (el texto oscuro de
         adentro se volvía ilegible) — tiene que ser opaco para que la
         tarjeta sea realmente clara pase lo que pase detrás. El texto de
         la descripción va en text-primary/75 (morado de marca, no
         text-muted-foreground) — a pedido del cliente, que no quería gris
         neutro dentro de estas tarjetas, solo tonos de la paleta de
         marca; el /75 en vez de opacidad completa es lo único que separa
         visualmente la descripción del título (que sí va a full opacity),
         para mantener algo de jerarquía sin salir del morado. Sin min-h: el
         alto de cada tarjeta es proporcional a su propio texto (a pedido
         del cliente, que las vio artificialmente iguales) — en
         desktop/tablet (grid de 2/4 columnas) el grid iguala la altura
         dentro de una misma fila cuando el contenido coincide, y en mobile
         (una columna) cada card queda con su propia altura natural.
         `.reveal` va en cada card por separado
         (no en el <ul>), a pedido del cliente, que las quería animadas:
         así cada una aparece con su propio fade-in-y-subida al entrar en
         pantalla, en vez de que las 4 aparezcan todas de golpe como un
         solo bloque. Título→cards en mt-5 sm:mt-7 (antes mt-10 lg:mt-14,
         mucho más grande que el resto de la página) — mismo valor que usa
         "Trámites" en la home (mb-5 sm:mb-7 en el título) para el salto de
         título a tarjetas; el mismo valor se repite en "Requisitos" y
         "Otros trámites" de esta página para que el ritmo título→contenido
         sea igual en toda la página, no distinto según si el contenido es
         un párrafo, una tarjeta o una píldora. Hover con leve elevación
         únicamente (hover:-translate-y-1, sin cambio de color — se probó
         hover:bg-lavender/25 y el cliente pidió sacarlo, solo quería el
         movimiento) — distinto de la regla de "Trámites"/"Testimonios"
         ("hover solo en el CTA, no en la card entera"): esas cards son
         enlaces con su propio "Ver más", así que el hover vive ahí; estas
         de "Cómo te ayudo" no son clicables (no tienen link ni CTA
         adentro), así que el hover en toda la tarjeta no compite con
         nada. -->
    <section aria-labelledby="pasos-titulo" class="bg-primary py-24 sm:py-32">
      <div class="mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
        <h2
          id="pasos-titulo"
          class="reveal font-heading leading-[1.05] font-medium text-primary-foreground"
          style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
        >
          Cómo te ayudo
        </h2>
        <ul class="mt-5 grid gap-5 sm:mt-7 sm:grid-cols-2 lg:grid-cols-4">
          {
            steps.map((step) => (
              <li class="reveal rounded-[2rem] bg-lavender p-7 transition-transform duration-200 hover:-translate-y-1">
                <h3 class="font-heading text-lg font-medium text-primary">{step.title}</h3>
                <p class="mt-0.5 leading-relaxed text-primary/75">{step.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ: mismo patrón de rejilla que la home (título a la izquierda,
         preguntas a la derecha). -->
    <section aria-labelledby="faq-titulo" class="bg-lavender/15 py-24 sm:py-32">
      <div class="mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
        <div class="reveal lg:grid lg:grid-cols-12 lg:gap-x-12">
          <div class="lg:col-span-4">
            <h2
              id="faq-titulo"
              class="font-heading leading-[1.05] font-medium text-primary"
              style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
            >
              Preguntas frecuentes
            </h2>
          </div>
          <div class="mt-5 sm:mt-7 lg:col-span-7 lg:col-start-6 lg:mt-0">
            <Faq items={faqs} />
          </div>
        </div>
      </div>
    </section>

    <!-- Otros trámites: enlaces internos rastreables a las demás páginas.
         Fondo claro (blanco), no lavanda — a pedido del cliente, para que
         no quede pegado visualmente a la franja de Preguntas frecuentes de
         arriba, que sí lleva fondo (bg-lavender/15). Ya no son píldoras
         con fondo: el cliente pidió que los CTAs de esta lista fueran solo
         texto + flecha, sin ningún tratamiento de botón, mismo lenguaje
         que "Ver más" en las cards de Trámites (texto en lavanda-deep,
         flecha que se desplaza al hover, sin caja). Tamaño de texto
         text-lg sm:text-xl — a pedido del cliente, igualado al tamaño de
         las preguntas del acordeón de FAQ (Faq.astro), no al tamaño chico
         que tenían antes como píldoras de nav. En mobile se apilan a la
         izquierda (flex-col items-start) y desde sm+ pasan a fila con
         wrap. -->
    <section aria-labelledby="otros-titulo" class="py-24 sm:py-32">
      <div class="mx-auto max-w-[100rem] px-6 sm:px-10 lg:px-16">
        <h2
          id="otros-titulo"
          class="reveal font-heading leading-[1.05] font-medium text-primary"
          style="font-size: clamp(1.85rem, 4.5vw, 3.25rem);"
        >
          Otros trámites con los que te ayudo
        </h2>
        <ul class="reveal mt-5 flex flex-col items-start gap-4 sm:mt-7 sm:flex-row sm:flex-wrap sm:gap-x-10 sm:gap-y-4">
          {
            related.map((s) => (
              <li>
                <a
                  href={servicePath(s.slug)}
                  class="group inline-flex items-center gap-2 font-heading text-lg font-semibold text-lavender-deep transition-colors hover:text-primary sm:text-xl"
                >
                  {s.title}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 shrink-0 transition-transform group-hover:translate-x-1"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
