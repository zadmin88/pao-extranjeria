---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import CtaSection from "@/components/CtaSection.astro";
import Faq from "@/components/Faq.astro";
import type { FaqItem } from "@/components/Faq.astro";
import { SITE, SERVICES, servicePath } from "@/config";
import type { Service } from "@/config";

interface Props {
  service: Service;
  seoTitle: string;
  seoDescription: string;
  heroIntro: string;
  faqs: FaqItem[];
}

const { service, seoTitle, seoDescription, heroIntro, faqs } = Astro.props;

const pageUrl = new URL(servicePath(service.slug), SITE.url).href;
const related = SERVICES.filter((s) => s.slug !== service.slug);

const stripHtml = (html: string) => html.replace(/<[^>]+>/g, "");

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: service.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.title,
    description: service.short,
    url: pageUrl,
    serviceType: service.title,
    areaServed: { "@type": "Country", name: "España" },
    availableChannel: {
      "@type": "ServiceChannel",
      name: "WhatsApp",
      servicePhone: { "@type": "ContactPoint", telephone: SITE.phoneDisplay },
    },
    provider: {
      "@type": "ProfessionalService",
      name: SITE.brand,
      url: SITE.url,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: stripHtml(f.a) },
    })),
  },
];
---

<BaseLayout title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <article>
    <header class="border-b border-border bg-secondary/50">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 md:py-16">
        <nav aria-label="Estás en" class="mb-5 text-sm text-muted-foreground">
          <a href="/" class="underline-offset-4 hover:text-foreground hover:underline">Inicio</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="text-foreground">{service.title}</span>
        </nav>
        <h1 class="font-heading text-3xl font-bold text-primary sm:text-4xl md:text-5xl">
          <slot name="h1" />
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          {heroIntro}
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-4">
          <WhatsAppButton size="lg" message={service.whatsAppMessage} label="Consulta tu caso por WhatsApp" />
          <p class="text-sm text-muted-foreground">Respuesta en el día · 100% online</p>
        </div>
      </div>
    </header>

    <div class="service-body mx-auto max-w-4xl px-4 py-10 sm:px-6 md:py-14">
      <slot />
    </div>

    <section aria-labelledby="faq-titulo" class="mx-auto max-w-4xl px-4 pb-14 sm:px-6">
      <h2 id="faq-titulo" class="font-heading text-2xl font-semibold text-primary sm:text-3xl">
        Preguntas frecuentes sobre {service.title.toLowerCase()}
      </h2>
      <div class="mt-6">
        <Faq items={faqs} />
      </div>
    </section>

    <section aria-labelledby="otros-titulo" class="border-t border-border bg-secondary/40">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <h2 id="otros-titulo" class="font-heading text-2xl font-semibold text-primary">
          Otros trámites con los que te ayudo
        </h2>
        <ul class="mt-5 flex flex-wrap gap-3">
          {
            related.map((s) => (
              <li>
                <a
                  href={servicePath(s.slug)}
                  class="inline-block rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary"
                >
                  {s.menuLabel}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>

  <CtaSection message={service.whatsAppMessage} />
</BaseLayout>
