---
import "@/styles/global.css";
import { SITE } from "@/config";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFloat from "@/components/WhatsAppFloat.astro";
import JsonLd from "@/components/JsonLd.astro";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** La barra de navegación arranca transparente, integrada a la foto del
   * hero, y se vuelve sólida al hacer scroll. Solo la usa la home. */
  transparentHeader?: boolean;
}

const { title, description, jsonLd, noindex = false, transparentHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/PO_Logo_6.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Blanco, no el eggplant de marca: con el eggplant, la barra de
         estado del teléfono quedaba oscura pegada arriba del header claro
         (transparente sobre el hero, o bg-nav-solid casi blanco) — se veía
         como una franja dura y desalineada del resto de la página, que es
         mayormente blanca (regla de fondo de página del manual). -->
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only rounded-lg bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50"
    >
      Saltar al contenido
    </a>
    <Header transparent={transparentHeader} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <script>
      import "@/scripts/scroll";
    </script>
    <script>
      // Flechas de los carruseles horizontales (Trámites/Testimonios en la
      // home, Requisitos en las páginas de trámite): desplazan el scroll
      // horizontal. Vive en BaseLayout (no en cada página) para que
      // cualquier [data-carousel] funcione sin duplicar el script.
      document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
        const name = carousel.dataset.carousel;
        const prev = document.querySelector<HTMLButtonElement>(`[data-carousel-prev="${name}"]`);
        const next = document.querySelector<HTMLButtonElement>(`[data-carousel-next="${name}"]`);
        const scrollByCard = (dir: 1 | -1) => {
          const card = carousel.querySelector<HTMLElement>(":scope > *");
          const gap = parseFloat(getComputedStyle(carousel).columnGap || "0");
          const step = card ? card.offsetWidth + gap : carousel.clientWidth * 0.85;
          carousel.scrollBy({ left: dir * step, behavior: "smooth" });
        };
        prev?.addEventListener("click", () => scrollByCard(-1));
        next?.addEventListener("click", () => scrollByCard(1));

        // Las flechas se desactivan solas en cada punta: "anterior" al
        // inicio del scroll, "siguiente" al final. El umbral de "inicio" no
        // puede ser 1px a secas: el snap-scroll (combinado con el sangrado
        // de margen negativo) asienta el carrusel unos px más allá de 0
        // apenas carga (~6px en desktop), sin que el usuario haya scrolleado
        // — con 1px la flecha "anterior" quedaba activa desde el principio.
        // Probar capturar ese punto de partida real con JS falla por una
        // carrera: el snap todavía no asentó cuando corre este script. Un
        // umbral fijo más generoso (bien por debajo de lo que mueve un paso
        // real de scroll, ~300px+) es más simple y no depende de timing.
        const updateButtons = () => {
          const max = carousel.scrollWidth - carousel.clientWidth;
          if (prev) prev.disabled = carousel.scrollLeft <= 16;
          if (next) next.disabled = carousel.scrollLeft >= max - 1;
        };
        updateButtons();
        carousel.addEventListener("scroll", updateButtons, { passive: true });
        window.addEventListener("resize", updateButtons);
      });
    </script>
  </body>
</html>
